---
import { getCollection } from 'astro:content';
import PixelIcon from '../ui/PixelIcon.astro';

interface Props {
  category: 'framework' | 'experiment' | 'essay' | 'note' | 'lab';
  title: string;
  subtitle: string;
  icon: 'cube' | 'sprout' | 'potion' | 'book' | 'flask';
}

const { category, title, subtitle, icon } = Astro.props;

const allDocs = await getCollection('docs');

const filteredArticles = allDocs
  .filter(doc => {
    const isCategory = doc.data.category === category;
    const isProd = import.meta.env.PROD;
    return isCategory && (!isProd || !doc.data.draft);
  })
  .sort((a, b) => {
    const dateA = new Date(a.data.dateUpdated || a.data.dateCreated).getTime();
    const dateB = new Date(b.data.dateUpdated || b.data.dateCreated).getTime();
    return dateB - dateA;
  });

const statusColorMap: Record<string, { bg: string; color: string; border: string }> = {
  validated: { bg: 'rgba(16, 185, 129, 0.15)', color: '#34d399', border: 'rgba(16, 185, 129, 0.3)' },
  testing: { bg: 'rgba(6, 182, 212, 0.15)', color: '#22d3ee', border: 'rgba(6, 182, 212, 0.3)' },
  hypothesis: { bg: 'rgba(251, 191, 36, 0.15)', color: '#fbbf24', border: 'rgba(251, 191, 36, 0.3)' },
  thought: { bg: 'rgba(139, 92, 246, 0.15)', color: '#a78bfa', border: 'rgba(139, 92, 246, 0.3)' },
  limited: { bg: 'rgba(245, 158, 11, 0.15)', color: '#f59e0b', border: 'rgba(245, 158, 11, 0.3)' },
  refuted: { bg: 'rgba(248, 113, 113, 0.15)', color: '#f87171', border: 'rgba(248, 113, 113, 0.3)' },
  deprecated: { bg: 'rgba(100, 116, 139, 0.15)', color: '#94a3b8', border: 'rgba(100, 116, 139, 0.3)' },
  superseded: { bg: 'rgba(100, 116, 139, 0.15)', color: '#64748b', border: 'rgba(100, 116, 139, 0.3)' },
};
---

<div class="category-page-header">
  <div class="header-icon-wrapper">
    <PixelIcon name={icon} size={32} />
  </div>
  <div>
    <h1 class="category-title">{title}</h1>
    <p class="category-subtitle">{subtitle}</p>
  </div>
</div>

<div class="articles-list">
  {filteredArticles.length === 0 ? (
    <div class="empty-state">
      <p>Aucun article trouvé dans cette catégorie pour le moment.</p>
    </div>
  ) : (
    filteredArticles.map(doc => {
      const statusStyle = statusColorMap[doc.data.status] || statusColorMap.thought;
      const formattedDate = new Date(doc.data.dateUpdated || doc.data.dateCreated).toLocaleDateString('fr-FR', {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
      });

      return (
        <a href={`/${doc.id}/`} class="article-card">
          <div class="card-header">
            <h2 class="article-title">{doc.data.title}</h2>
            <div class="status-badges">
              <span
                class="status-badge"
                style={`background-color: ${statusStyle.bg}; color: ${statusStyle.color}; border: 1px solid ${statusStyle.border};`}
              >
                {doc.data.status}
              </span>
              <span class="version-badge">v{doc.data.version}</span>
            </div>
          </div>

          <p class="article-description">{doc.data.description}</p>

          <div class="card-footer">
            <div class="meta-tags">
              <span class="meta-date">{formattedDate}</span>
              <span class="meta-dot">•</span>
              <span class="meta-confidence">Confiance: {doc.data.confidence}</span>
            </div>

            {doc.data.tags && doc.data.tags.length > 0 && (
              <div class="tags-container">
                {doc.data.tags.map(tag => (
                  <span class="tag-pill">#{tag}</span>
                ))}
              </div>
            )}
          </div>
        </a>
      );
    })
  )}
</div>

<style>
  .category-page-header {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-bottom: 2rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .header-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: var(--radius);
    background-color: var(--surface);
    border: 1px solid var(--border-subtle);
  }

  .category-title {
    font-size: 2rem;
    font-weight: 700;
    color: var(--text);
  }

  .category-subtitle {
    font-size: 1rem;
    color: var(--text-muted);
    margin-top: 0.2rem;
  }

  .articles-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .article-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    background-color: var(--surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);

    text-decoration: none;
  }

  .article-card:hover {
    border-color: var(--violet);
    box-shadow: 0 8px 24px -8px var(--violet-glow);
    transform: translateY(-2px);
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .article-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text);
  }

  .status-badges {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .status-badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    text-transform: lowercase;
    font-weight: 600;
  }

  .version-badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    background-color: var(--surface-muted);
    color: var(--text-muted);
    border: 1px solid var(--border-subtle);
  }

  .article-description {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.825rem;
  }

  .meta-tags {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .meta-dot {
    color: var(--border);
  }

  .meta-confidence {
    color: var(--cyan-bright);
  }

  .tags-container {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .tag-pill {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--violet-bright);
    background-color: rgba(139, 92, 246, 0.1);
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
  }

  .empty-state {
    padding: 3rem;
    text-align: center;
    background-color: var(--surface);
    border-radius: var(--radius);
    color: var(--text-muted);
  }
</style>
