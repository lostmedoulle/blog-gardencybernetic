---
import PixelIcon from '../ui/PixelIcon.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { name: 'Home', href: '/', icon: 'home' as const, active: currentPath === '/' },
  { name: 'Frameworks', href: '/docs/frameworks/the-work-once-principle', icon: 'cube' as const, active: currentPath.includes('/frameworks') },
  { name: 'Essays', href: '/docs/essays/designing-systems-that-heal', icon: 'book' as const, active: currentPath.includes('/essays') },
  { name: 'Experiments', href: '/docs/experiments/automated-feedback-loops', icon: 'flask' as const, active: currentPath.includes('/experiments') },
  { name: 'About', href: '#about', icon: 'user' as const, active: currentPath === '#about' },
];
---

<aside class="sidebar">
  <div class="sidebar-header">
    <a href="/" class="brand-link">
      <div class="avatar-wrapper">
        <PixelIcon name="avatar" size={38} />
      </div>
      <div class="brand-info">
        <span class="brand-name">
          Med's <span class="accent-text">Cybernetic</span> Garden 🌱
        </span>
      </div>
    </a>
  </div>

  <nav class="sidebar-nav" aria-label="Main Navigation">
    <ul class="nav-list">
      {navItems.map(item => (
        <li>
          <a href={item.href} class={`nav-link ${item.active ? 'active' : ''}`}>
            <span class="nav-icon">
              <PixelIcon name={item.icon} size={18} />
            </span>
            <span class="nav-label">{item.name}</span>
          </a>
        </li>
      ))}
    </ul>

    <div class="nav-divider"></div>

    <div class="search-link-wrapper">
      <a href="#search" class="search-btn">
        <PixelIcon name="search" size={16} />
        <span>Search</span>
        <kbd class="kbd-badge">⌘K</kbd>
      </a>
    </div>
  </nav>

  <div class="sidebar-footer">
    <div class="social-links">
      <a href="https://github.com" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
        <PixelIcon name="github" size={18} />
      </a>
      <a href="#rss" aria-label="RSS Feed">
        <PixelIcon name="rss" size={18} />
      </a>
      <a href="mailto:med@example.com" aria-label="Email">
        <PixelIcon name="mail" size={18} />
      </a>
    </div>

    <div class="footer-meta">
      <p class="copyright">© 2025 Med</p>
      <p class="tagline">Building in public.<br />Thinking in systems.</p>
    </div>

    <div class="pixel-plant-mascot">
      <PixelIcon name="sprout" size={32} />
    </div>
  </div>
</aside>

<style>
  .sidebar {
    width: var(--sidebar-width);
    height: 100vh;
    position: fixed;
    top: 0;
    left: 0;
    background-color: var(--background);
    border-right: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    padding: 1.75rem 1.25rem;
    z-index: 50;
    overflow-y: auto;
  }

  .sidebar-header {
    margin-bottom: 2rem;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    color: var(--text);
    transition: opacity 0.2s ease;
  }

  .brand-link:hover {
    opacity: 0.9;
  }

  .avatar-wrapper {
    position: relative;
    flex-shrink: 0;
  }

  .brand-info {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--text);
  }

  .accent-text {
    color: var(--violet-bright);
  }

  .sidebar-nav {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.65rem 0.85rem;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-size: 0.95rem;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .nav-link:hover {
    color: var(--text);
    background-color: var(--surface);
  }

  .nav-link.active {
    color: var(--violet-bright);
    background-color: rgba(139, 92, 246, 0.12);
    font-weight: 600;
  }

  .nav-icon {
    display: flex;
    align-items: center;
  }

  .nav-divider {
    height: 1px;
    background-color: var(--border-subtle);
    margin: 1.25rem 0;
  }

  .search-btn {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.85rem;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-size: 0.9rem;
    background-color: var(--surface-muted);
    border: 1px solid var(--border-subtle);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .search-btn:hover {
    color: var(--text);
    border-color: var(--violet);
  }

  .kbd-badge {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    background-color: var(--background);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    border: 1px solid var(--border);
    color: var(--text-muted);
  }

  .sidebar-footer {
    margin-top: auto;
    padding-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .social-links {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--text-muted);
  }

  .social-links a {
    transition: color 0.2s ease;
  }

  .social-links a:hover {
    color: var(--violet-bright);
  }

  .footer-meta {
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  .copyright {
    font-weight: 600;
    color: var(--text);
    margin-bottom: 0.2rem;
  }

  .pixel-plant-mascot {
    margin-top: 0.5rem;
    opacity: 0.85;
    transition: transform 0.3s ease;
  }

  .pixel-plant-mascot:hover {
    transform: translateY(-2px) scale(1.05);
  }

  /* Responsive drawer behavior for smaller screens */
  @media (max-width: 900px) {
    .sidebar {
      position: relative;
      width: 100%;
      height: auto;
      border-right: none;
      border-bottom: 1px solid var(--border-subtle);
    }
  }
</style>
