---
import PixelIcon from './PixelIcon.astro';

interface Props {
  title: string;
  icon?: 'star' | 'cube' | 'sprout' | 'potion';
  subtitle?: string;
  class?: string;
}

const { title, icon, subtitle, class: className = '' } = Astro.props;
---

<div class={`section-heading ${className}`}>
  <div class="heading-title-row">
    {icon && (
      <span class="heading-icon">
        <PixelIcon name={icon} size={20} />
      </span>
    )}
    <h2>{title}</h2>
  </div>
  {subtitle && <p class="heading-subtitle">{subtitle}</p>}
</div>

<style>
  .section-heading {
    margin-bottom: 2rem;
  }

  .heading-title-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .heading-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  h2 {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.01em;
  }

  .heading-subtitle {
    margin-top: 0.25rem;
    font-size: 0.95rem;
    color: var(--text-muted);
  }
</style>
