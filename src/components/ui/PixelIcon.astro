---
interface Props {
  name: 'avatar' | 'cube' | 'sprout' | 'potion' | 'star' | 'home' | 'book' | 'flask' | 'user' | 'search' | 'github' | 'rss' | 'mail' | 'arrow' | 'tree' | 'robot' | 'save' | 'share' | 'edit' | 'moon' | 'options' | 'lamp' | 'target-plant' | 'heading-box' | 'heart';
  size?: number;
  class?: string;
}

const { name, size = 20, class: className = '' } = Astro.props;
---

{name === 'avatar' && (
  <svg width={size} height={size} viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" class={className} style="shape-rendering: crispEdges;">
    <rect width="32" height="32" rx="16" fill="#182030" />
    <rect x="1" y="1" width="30" height="30" rx="15" stroke="#8b5cf6" stroke-width="1.5" stroke-opacity="0.5" />
    <path d="M10 6h12v3H10zM8 9h16v4H8zM6 13h4v4H6zM22 13h4v4h-4z" fill="#2d1b0e" />
    <rect x="10" y="13" width="12" height="10" fill="#fcd34d" />
    <rect x="12" y="15" width="2" height="3" fill="#0f172a" />
    <rect x="18" y="15" width="2" height="3" fill="#0f172a" />
    <rect x="11" y="18" width="2" height="1" fill="#f87171" />
    <rect x="19" y="18" width="2" height="1" fill="#f87171" />
    <rect x="15" y="19" width="2" height="1" fill="#78350f" />
    <rect x="8" y="23" width="16" height="6" fill="#6366f1" />
    <rect x="13" y="23" width="6" height="3" fill="#38bdf8" />
  </svg>
)}

{name === 'cube' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class={className} style="shape-rendering: crispEdges;">
    <path d="M12 2L4 6v8l8 4 8-4V6l-8-4z" fill="#6d28d9" fill-opacity="0.3" stroke="#a78bfa" stroke-width="1.5" />
    <path d="M12 2v10M4 6l8 4M20 6l-8 4" stroke="#c084fc" stroke-width="1.5" />
    <rect x="7" y="14" width="2" height="2" fill="#c084fc" />
    <rect x="15" y="14" width="2" height="2" fill="#c084fc" />
    <rect x="11" y="17" width="2" height="2" fill="#38bdf8" />
  </svg>
)}

{name === 'sprout' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class={className} style="shape-rendering: crispEdges;">
    <path d="M6 19h12v2H6z" fill="#78350f" />
    <path d="M11 12h2v7h-2z" fill="#10b981" />
    <path d="M6 9h5v4H6z" fill="#34d399" />
    <path d="M7 8h3v1H7z" fill="#6ee7b7" />
    <path d="M13 10h5v4h-5z" fill="#10b981" />
    <path d="M14 9h3v1h-3z" fill="#34d399" />
  </svg>
)}

{name === 'potion' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class={className} style="shape-rendering: crispEdges;">
    <rect x="10" y="2" width="4" height="2" fill="#b45309" />
    <rect x="9" y="4" width="6" height="3" fill="#1e293b" stroke="#38bdf8" stroke-width="1" />
    <path d="M7 9h10l4 10H3L7 9z" fill="#0f172a" stroke="#38bdf8" stroke-width="1.5" />
    <path d="M5 14h14l1 4H4l1-4z" fill="#06b6d4" fill-opacity="0.8" />
    <rect x="10" y="11" width="2" height="2" fill="#22d3ee" />
    <rect x="13" y="15" width="2" height="2" fill="#a78bfa" />
  </svg>
)}

{name === 'star' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class={className} style="shape-rendering: crispEdges;">
    <path d="M11 2h2v7h7v2h-7v7h-2v-7H4v-2h7V2z" fill="#f59e0b" />
    <rect x="10" y="10" width="4" height="4" fill="#fbbf24" />
  </svg>
)}

{name === 'home' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class={className}>
    <path d="M3 10.5L12 3l9 7.5V20a1 1 0 01-1 1h-5v-6h-6v6H4a1 1 0 01-1-1v-9.5z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}

{name === 'book' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class={className}>
    <path d="M4 19.5A2.5 2.5 0 016.5 17H20M4 19.5A2.5 2.5 0 006.5 22H20V3H6.5A2.5 2.5 0 004 5.5v14z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}

{name === 'flask' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class={className}>
    <path d="M10 2v5.5L4.5 17A2 2 0 006.2 20h11.6a2 2 0 001.7-3L14 7.5V2h-4zM8.5 2h7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}

{name === 'user' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class={className}>
    <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2M12 11a4 4 0 100-8 4 4 0 000 8z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}

{name === 'search' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class={className}>
    <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}

{name === 'github' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class={className}>
    <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
  </svg>
)}

{name === 'rss' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class={className}>
    <path d="M4 11a9 9 0 0 1 9 9"></path>
    <path d="M4 4a16 16 0 0 1 16 16"></path>
    <circle cx="5" cy="19" r="1"></circle>
  </svg>
)}

{name === 'mail' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class={className}>
    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
    <polyline points="22,6 12,13 2,6"></polyline>
  </svg>
)}

{name === 'arrow' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={className}>
    <line x1="5" y1="12" x2="19" y2="12"></line>
    <polyline points="12 5 19 12 12 19"></polyline>
  </svg>
)}

{name === 'tree' && (
  <svg width={size} height={size} viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" class={className} style="shape-rendering: crispEdges;">
    <rect width="64" height="64" rx="8" fill="#0f172a" />
    <circle cx="48" cy="16" r="8" fill="#fbbf24" fill-opacity="0.2" />
    <path d="M12 44h40l-8 12H20L12 44z" fill="#334155" />
    <rect x="14" y="42" width="36" height="3" fill="#10b981" />
    <rect x="29" y="28" width="6" height="14" fill="#78350f" />
    <rect x="22" y="16" width="20" height="14" rx="4" fill="#10b981" />
    <rect x="18" y="20" width="28" height="8" rx="2" fill="#34d399" />
    <rect x="26" y="12" width="12" height="6" fill="#6ee7b7" />
  </svg>
)}

{name === 'robot' && (
  <svg width={size} height={size} viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" class={className} style="shape-rendering: crispEdges;">
    <rect x="15" y="2" width="2" height="4" fill="#64748b" />
    <rect x="14" y="1" width="4" height="2" fill="#34d399" />
    <rect x="6" y="6" width="20" height="16" rx="4" fill="#1e293b" stroke="#475569" stroke-width="1.5" />
    <rect x="9" y="9" width="14" height="10" rx="2" fill="#090d16" />
    <rect x="11" y="12" width="3" height="4" rx="1" fill="#34d399" />
    <rect x="18" y="12" width="3" height="4" rx="1" fill="#34d399" />
    <rect x="10" y="16" width="2" height="1" fill="#a78bfa" />
    <rect x="20" y="16" width="2" height="1" fill="#a78bfa" />
  </svg>
)}

{name === 'save' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class={className}>
    <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
    <polyline points="17 21 17 13 7 13 7 21"></polyline>
    <polyline points="7 3 7 8 15 8"></polyline>
  </svg>
)}

{name === 'share' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class={className}>
    <circle cx="18" cy="5" r="3"></circle>
    <circle cx="6" cy="12" r="3"></circle>
    <circle cx="18" cy="19" r="3"></circle>
    <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
    <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
  </svg>
)}

{name === 'edit' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class={className}>
    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
  </svg>
)}

{name === 'moon' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class={className}>
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
)}

{name === 'options' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={className}>
    <circle cx="12" cy="12" r="1"></circle>
    <circle cx="19" cy="12" r="1"></circle>
    <circle cx="5" cy="12" r="1"></circle>
  </svg>
)}

{name === 'heading-box' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class={className} style="shape-rendering: crispEdges;">
    <rect x="2" y="2" width="20" height="20" rx="4" fill="#0f172a" stroke="#10b981" stroke-width="1.5" />
    <rect x="7" y="7" width="10" height="10" rx="2" fill="#10b981" fill-opacity="0.3" />
    <rect x="9" y="9" width="6" height="6" fill="#34d399" />
  </svg>
)}

{name === 'lamp' && (
  <svg width={size} height={size} viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" class={className} style="shape-rendering: crispEdges;">
    <path d="M12 40h24v4H12z" fill="#1e293b" />
    <path d="M22 24h4v16h-4z" fill="#475569" />
    <path d="M14 10h20l4 14H10l4-14z" fill="#0f172a" stroke="#fbbf24" stroke-width="1.5" />
    <circle cx="24" cy="24" r="3" fill="#fbbf24" />
  </svg>
)}

{name === 'target-plant' && (
  <svg width={size} height={size} viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" class={className} style="shape-rendering: crispEdges;">
    <path d="M8 16V8h8M56 16V8h-8M8 48v8h8M56 48v8h-8" stroke="#10b981" stroke-width="2" stroke-linecap="square" />
    <rect x="24" y="38" width="16" height="14" fill="#78350f" />
    <path d="M30 22h4v16h-4z" fill="#10b981" />
    <rect x="22" y="16" width="8" height="8" rx="2" fill="#34d399" />
    <rect x="34" y="20" width="8" height="8" rx="2" fill="#10b981" />
  </svg>
)}

{name === 'heart' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class={className} style="shape-rendering: crispEdges;">
    <path d="M5 4h4v2H5zM15 4h4v2h-4zM3 6h3v3H3zM18 6h3v3h-3zM4 9h16v3H4zM5 12h14v2H5zM7 14h10v2H7zM9 16h6v2H9zM11 18h2v2h-2z" fill="#f472b6" fill-opacity="0.35" />
    <path d="M5 4h4v2H5zM15 4h4v2h-4zM3 6h3v3H3zM18 6h3v3h-3zM4 9h16v3H4zM5 12h14v2H5zM7 14h10v2H7zM9 16h6v2H9zM11 18h2v2h-2z" stroke="#f472b6" stroke-width="0.75" />
    <rect x="6" y="7" width="2" height="2" fill="#fbcfe8" />
  </svg>
)}
