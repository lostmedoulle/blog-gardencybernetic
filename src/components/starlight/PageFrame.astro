---
import Sidebar from '../home/Sidebar.astro';
import ArticleHeader from './ArticleHeader.astro';
import ArticleMetaSidebar from './ArticleMetaSidebar.astro';
import SupportCTA from '../support/SupportCTA.astro';
import { formatDate, articleDate } from '../../utils/dates';
import { stripBase } from '../../utils/paths';
import '../../styles/tokens.css';
import '../../styles/global.css';

const currentPath = Astro.url.pathname;
// Comparaison de route : retirer la base, sinon le sous-chemin de GitHub Pages
// compterait comme un segment et toute page passerait pour un article.
const isDocPage = stripBase(currentPath).split('/').filter(Boolean).length >= 2;

const entry = Astro.props.entry;
const frontmatter = entry?.data || {};
// `headings` est une prop de premier niveau de StarlightRouteData, pas une
// propriété de `entry`. La lire au mauvais endroit renvoyait toujours [], ce
// qui faisait tomber ArticleMetaSidebar sur son sommaire de démonstration.
const headings = (Astro.props.headings || []).filter(h => h.depth >= 2 && h.depth <= 3);

const REPO_EDIT_BASE =
  'https://github.com/lostmedoulle/blog-gardencybernetic/edit/main/src/content/docs';
const editUrl = entry?.id ? `${REPO_EDIT_BASE}/${entry.id}.md` : undefined;
const shareUrl = Astro.site ? new URL(currentPath, Astro.site).href : currentPath;
---

<div class="layout-container">
  <!-- Left Main Navigation Sidebar -->
  <Sidebar currentPath={currentPath} />

  <!-- Main Content Wrapper -->
  <div class="content-wrapper">
    <div class="article-grid">
      <!-- Center Main Content -->
      <main class="main-content" id="main-content">
        {isDocPage && (
          <ArticleHeader
            title={frontmatter.title}
            description={frontmatter.description}
            category={frontmatter.category || 'Framework'}
            status={frontmatter.status || 'Hypothesis'}
            confidence={frontmatter.confidence || 'Medium'}
            version={frontmatter.version || '0.1.0'}
            dateCreated={formatDate(frontmatter.dateCreated)}
            readingTime={frontmatter.readingTime ? `${frontmatter.readingTime} min de lecture` : ''}
            editUrl={editUrl}
            shareUrl={shareUrl}
            cover={frontmatter.cover}
            coverAlt={frontmatter.coverAlt}
          />
        )}

        <div class="article-markdown-body">
          <slot />
        </div>

        {isDocPage && <SupportCTA />}
      </main>

      <!-- Right Metadata & Table of Contents Sidebar -->
      {isDocPage && (
        <ArticleMetaSidebar
          toc={headings}
          status={frontmatter.status}
          category={frontmatter.category}
          tags={frontmatter.tags}
          language={frontmatter.language}
          author={frontmatter.authors ? frontmatter.authors[0] : 'Med'}
          dateUpdated={formatDate(articleDate(frontmatter))}
        />
      )}
    </div>
  </div>
</div>

<style>
  .layout-container {
    display: flex;
    min-height: 100vh;
    background-color: var(--background);
    color: var(--text);
  }

  .content-wrapper {
    flex: 1;
    margin-left: var(--sidebar-width);
    padding: 2rem 2.5rem;
    max-width: calc(100vw - var(--sidebar-width));
    overflow-x: hidden;
  }

  .article-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: 3.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .main-content {
    min-width: 0;
  }

  @media (max-width: 1100px) {
    .article-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .content-wrapper {
      margin-left: 0;
      padding: 1.5rem 1.25rem;
      max-width: 100%;
    }
  }
</style>
