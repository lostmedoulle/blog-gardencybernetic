---

interface TocItem {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  toc?: TocItem[];
  status?: string;
  category?: string;
  tags?: string[];
  language?: string;
  author?: string;
  dateUpdated?: string;
}

const {
  toc = [],
  status = 'thought',
  category = 'note',
  tags = [],
  language = 'FR',
  author = 'Med',
  dateUpdated = '',
} = Astro.props;

// Pas de sommaire de secours : afficher des sections qui n'existent pas dans
// l'article est pire que ne rien afficher.
const activeToc = toc;
---

<aside class="article-meta-sidebar">
  <!-- Sommaire / Table of Contents -->
  {activeToc.length > 0 && (
    <div class="toc-panel">
      <h3 class="toc-heading">SOMMAIRE</h3>
      <nav class="toc-list-nav">
        <ul class="toc-list">
          {activeToc.map((item: any, idx: number) => (
            <li>
              <a
                href={`#${item.slug}`}
                class={`toc-item-link ${idx === 0 ? 'active' : ''} ${item.depth === 3 ? 'nested' : ''}`}
              >
                {idx === 0 && <span class="toc-active-bar"></span>}
                <span class="toc-text">{item.text}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  )}

  <!-- Metadata Card -->
  <div class="meta-card-panel">
    <div class="meta-field">
      <span class="meta-label">STATUT</span>
      <span class="meta-value">{status}</span>
    </div>

    <div class="meta-field">
      <span class="meta-label">CATÉGORIE</span>
      <span class="meta-value">{category}</span>
    </div>

    <div class="meta-field">
      <span class="meta-label">TAGS</span>
      <div class="meta-tags-list">
        {tags.map((tag: string) => (
          <span class="tag-badge">{tag}</span>
        ))}
      </div>
    </div>

    <div class="meta-field">
      <span class="meta-label">LANGUE</span>
      <span class="meta-value">{language.toUpperCase()}</span>
    </div>

    <div class="meta-field">
      <span class="meta-label">AUTEUR</span>
      <span class="meta-value">{author}</span>
    </div>

    {dateUpdated && (
      <div class="meta-field">
        <span class="meta-label">DERNIÈRE MISE À JOUR</span>
        <span class="meta-value">{dateUpdated}</span>
      </div>
    )}
  </div>
</aside>

<style>
  .toc-item-link.nested .toc-text {
    padding-left: 0.85rem;
    font-size: 0.8rem;
    opacity: 0.8;
  }

  .article-meta-sidebar {
    width: 260px;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    position: sticky;
    top: 2rem;
    height: fit-content;
  }

  .toc-panel {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .toc-heading {
    font-family: var(--font-mono);
    font-size: 0.775rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.08em;
  }

  .toc-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .toc-item-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    transition: color 0.2s ease;
    line-height: 1.4;
    text-decoration: none;
    position: relative;
    padding-left: 0.5rem;
  }

  .toc-item-link:hover {
    color: var(--text);
  }

  .toc-item-link.active {
    color: var(--green-bright);
    font-weight: 600;
  }

  .toc-active-bar {
    position: absolute;
    left: 0;
    top: 2px;
    bottom: 2px;
    width: 2px;
    background-color: var(--green-bright);
    box-shadow: 0 0 8px var(--green);
  }

  .meta-card-panel {
    background-color: var(--surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    font-family: var(--font-mono);
  }

  .meta-field {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .meta-label {
    font-size: 0.725rem;
    color: var(--text-muted);
    letter-spacing: 0.06em;
  }

  .meta-value {
    font-size: 0.875rem;
    color: var(--text);
    font-weight: 500;
  }

  .meta-tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.15rem;
  }

  .tag-badge {
    font-size: 0.75rem;
    background-color: var(--surface-muted);
    color: var(--text-muted);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    border: 1px solid var(--border-subtle);
  }

  @media (max-width: 1100px) {
    .article-meta-sidebar {
      width: 100%;
      position: relative;
      top: 0;
    }
  }
</style>
