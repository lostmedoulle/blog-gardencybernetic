---
/**
 * Injecte la mesure d'audience sur les pages qui n'utilisent pas la
 * configuration `head` de Starlight (accueil, catégories, support, export…).
 * Ne rend rien tant qu'aucun fournisseur n'est configuré.
 */
import { ANALYTICS, analyticsTags } from '../config/analytics.mjs';

const tags = analyticsTags(ANALYTICS, import.meta.env.PROD);
---

{tags.map(t =>
  t.content
    ? <script is:inline set:html={t.content} />
    : <script {...t.attrs} is:inline />
)}
